---
import Base from "../layouts/Base.astro";
import DocTool from "./DocTool.astro";
import { SITE } from "../lib/site";

interface Props {
  kind: "invoice" | "quotation";
  title: string;
  description: string;
  h1: string;
  lead: string;
  stepsTitle: string;
  steps: { t: string; d: string }[];
  includesTitle: string;
  includes: string[];
  faqs: { q: string; a: string }[];
  related: { href: string; label: string }[];
}
const { kind, title, description, h1, lead, stepsTitle, steps, includesTitle, includes, faqs, related } = Astro.props;
const path = kind === "invoice" ? "/free-invoice-generator/" : "/free-quotation-generator/";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: h1,
    url: SITE.url + path,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any",
    description,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    publisher: { "@type": "Organization", name: SITE.company },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
const appTpls = [
  { id: "aurora", n: "Aurora" }, { id: "holo", n: "Holo" }, { id: "orbit", n: "Orbit" },
  { id: "mosaic", n: "Mosaic" }, { id: "neon", n: "Neon" },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="tp-hero">
    <div class="wrap">
      <span class="kicker">Free tool</span>
      <h1>{h1.split(" ").slice(0, -1).join(" ")} <em>{h1.split(" ").slice(-1).join(" ")}</em></h1>
      <p class="lead">{lead}</p>
    </div>
  </section>

  <section class="tp-tool">
    <div class="wrap">
      <aside class="tpl-strip" aria-label="Templates available in the app">
        <div class="ts-text">
          <p class="ts-title">Need <em>fancy</em> templates?</p>
        </div>
        <div class="ts-track">
          {appTpls.map((t) => (
            <a class="tp" href={SITE.playUrl} rel="noopener" aria-label={`${t.n} template, available in the app`} title={`${t.n} (in the app)`}>
              <span class="tp-img">
                <img src={`/templates/${t.id}.webp`} alt="" width="640" height="905" loading="lazy" />
                <span class="lock" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
              </span>
            </a>
          ))}
        </div>
        <a class="gp ts-gp" href={SITE.playUrl} rel="noopener" aria-label="Get the app now on Google Play"><img src="/google-play-badge.svg" alt="Get it on Google Play" width="217" height="63" /></a>
      </aside>
      <DocTool kind={kind} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prose">
        <h2>{stepsTitle}</h2>
        <ol>{steps.map((s) => <li><strong>{s.t}</strong> {s.d}</li>)}</ol>
        <h2>{includesTitle}</h2>
        <ul>{includes.map((i) => <li>{i}</li>)}</ul>

        <div class="callout">
          <p><strong>Need more than {SITE.freeLimit} {kind}s a month?</strong></p>
          <p>The FreelanceDesk app is free to start, and Premium removes the limits. It also tracks your clients, payments and income, and works offline. Your data stays on your phone.</p>
          <p><a class="btn btn-primary btn-sm" href={SITE.playUrl} rel="noopener" style="margin-top:8px">Get the app on Google Play</a></p>
        </div>

        <h2>Frequently asked questions</h2>
        {faqs.map((f) => <details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}

        <h2>Keep reading</h2>
        <ul>{related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}</ul>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .tp-hero { position: relative; margin-top: -80px; padding-block: clamp(120px, 12vw, 160px) clamp(44px, 5vw, 70px); background: linear-gradient(120deg, #0a2cb0 0%, #1654e6 45%, #2f84ff 100%); }
  .tp-hero .lead { color: #dbe7ff; }
  .tp-hero .kicker { color: #cfe0ff; }
  .tp-hero h1 { margin: 22px 0 20px; font-size: clamp(3rem, 8vw, 6.8rem); max-width: 14ch; line-height: .92; }
  .tp-hero .lead { max-width: 52ch; }

  .tpl-strip { position: relative; overflow: hidden; margin-bottom: 26px; padding: 18px 26px; border-radius: 26px; background: linear-gradient(110deg, #fff0b8 0%, #ffd36b 38%, #e9b44c 72%, #c98f2e 100%); box-shadow: 0 22px 46px rgba(0,10,60,.35), inset 0 1px 0 rgba(255,255,255,.7); display: flex; align-items: center; gap: 28px; color: #1c1304; }
  .tpl-strip::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(100deg, transparent 30%, rgba(255,255,255,.55) 50%, transparent 70%); background-size: 250% 100%; background-position: 130% 0; animation: tsShine 5.5s ease-in-out infinite; }
  @keyframes tsShine { 0%, 55% { background-position: 130% 0; } 100% { background-position: -40% 0; } }
  .ts-text { min-width: 0; flex: 1 1 260px; position: relative; z-index: 1; }
  .ts-title { font-size: clamp(1.7rem, 3.1vw, 2.8rem); font-weight: 600; letter-spacing: -.05em; line-height: 1; color: #140c00; white-space: nowrap; }
  .ts-title em { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 1.12em; letter-spacing: -.02em; color: #0a1433; padding-right: .04em; }
  .ts-track { display: flex; flex: none; position: relative; z-index: 1; padding: 6px 4px; }
  .tp { display: block; flex: none; width: 62px; margin-left: -12px; text-decoration: none; transition: transform .25s ease; }
  .tp:first-child { margin-left: 0; }
  .tp:nth-child(odd) { transform: rotate(-5deg); } .tp:nth-child(even) { transform: rotate(4deg) translateY(4px); }
  .tp:hover { transform: rotate(0) translateY(-6px) scale(1.06); z-index: 3; }
  .tp-img { position: relative; display: block; border-radius: 7px; overflow: hidden; aspect-ratio: 640 / 905; background: #111; box-shadow: 0 10px 20px rgba(60,35,0,.45); border: 1.5px solid rgba(255,255,255,.7); }
  .tp-img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .lock { position: absolute; z-index: 2; top: 3px; right: 3px; width: 17px; height: 17px; display: grid; place-items: center; background: rgba(4,10,40,.9); border: 1px solid rgba(255,255,255,.3); color: #fff; border-radius: 50%; }
  .ts-gp { position: relative; z-index: 1; flex: none; } .ts-gp img { height: 52px; filter: drop-shadow(0 8px 14px rgba(40,22,0,.4)); }
  @media (max-width: 760px) {
    .tpl-strip { display: grid; grid-template-columns: 1fr auto; gap: 12px 14px; padding: 16px 16px; border-radius: 22px; }
    .ts-text { grid-column: 1 / -1; } .ts-title { font-size: clamp(1.45rem, 6.6vw, 2rem); }
    .ts-track { grid-column: 1; grid-row: 2; overflow: visible; }
    .tp { width: 50px; }
    .ts-gp { grid-column: 2; grid-row: 2; align-self: center; } .ts-gp img { height: 44px; }
  }
  .tp-tool { padding-block: 44px 80px; background: linear-gradient(180deg, #0a2a8a 0%, #1654e6 45%, #0a2a8a 100%); }
  .prose .faq { border-bottom: 1px solid var(--line); }
  .prose .faq summary { cursor: pointer; font-weight: 700; padding: 16px 0; list-style: none; display: flex; justify-content: space-between; gap: 16px; color: #fff; }
  .prose .faq summary::-webkit-details-marker { display: none; } .prose .faq summary::after { content: "+"; color: var(--blue-light); font-size: 1.4rem; line-height: 1; }
  .prose .faq[open] summary::after { content: "–"; } .prose .faq p { margin: 0 0 16px; }
</style>
