---
import Base from "../../layouts/Base.astro";
import Cover from "../../components/Cover.astro";
import { posts, withToc, type Post } from "../../content/posts";
import { SITE } from "../../lib/site";
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: Post }
const { post } = Astro.props;
const fmt = (iso: string) => new Date(iso + "T00:00:00").toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
// related: same category first, then the rest
const others = posts.filter((p) => p.slug !== post.slug);
const more = [...others.filter((p) => p.category === post.category), ...others.filter((p) => p.category !== post.category)].slice(0, 3);
const url = `${SITE.url}/blog/${post.slug}/`;
const ext = ["jpg", "jpeg", "png", "webp"].find((e) => fs.existsSync(path.join(process.cwd(), "public", "blog", `${post.slug}.${e}`)));
const ogImage = ext ? `/blog/${post.slug}.${ext}` : undefined;
const { body, toc } = withToc(post.body);

const jsonLd = [
  {
    "@context": "https://schema.org", "@type": "BlogPosting",
    headline: post.title, description: post.description, datePublished: post.date, dateModified: post.date,
    mainEntityOfPage: url, articleSection: post.category,
    ...(ogImage ? { image: SITE.url + ogImage } : {}),
    author: { "@type": "Organization", name: SITE.company },
    publisher: { "@type": "Organization", name: SITE.company, logo: { "@type": "ImageObject", url: SITE.url + "/logo-mark.png" } },
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Blog", item: SITE.url + "/blog/" },
      { "@type": "ListItem", position: 3, name: post.title, item: url },
    ],
  },
];
---
<Base title={post.title} description={post.description} type="article" published={post.date} jsonLd={jsonLd} image={ogImage}>
  <article>
    <header class="post-head">
      <div class="wrap">
        <a class="crumb" href="/blog/">← All blog</a>
        <span class="eyebrow">{post.category}</span>
        <h1 class="post-title">{post.title}</h1>
        <p class="post-meta">{fmt(post.date)} · {post.minutes} min read · By {SITE.company}</p>
      </div>
    </header>
    <div class="wrap"><div class="post-cover"><Cover slug={post.slug} /></div></div>

    <div class="wrap post-layout">
      <aside class="toc" aria-label="On this page">
        <b>On this page</b>
        <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
      </aside>
      <div class="prose" style="margin:0">
        <div set:html={body} />

        <div class="callout">
          <p>Make your next one in minutes.</p>
          <p>Create a free invoice or quotation in your browser, or get the FreelanceDesk app to handle clients, payments and income.</p>
          <p style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px">
            <a class="btn btn-primary btn-sm" href="/free-invoice-generator/">Free invoice generator</a>
            <a class="btn btn-ghost btn-sm" href="/free-quotation-generator/">Free quotation generator</a>
            <a class="btn btn-ghost btn-sm" href={SITE.playUrl} rel="noopener">Get the app</a>
          </p>
        </div>
      </div>
    </div>
  </article>

  <section class="wrap" style="padding-block:40px clamp(80px,10vw,130px)">
    <span class="kicker">Keep reading</span>
    <div class="more-grid">
      {more.map((p) => (
        <a class="pcard" href={`/blog/${p.slug}/`}>
          <div class="pimg"><Cover slug={p.slug} /></div>
          <div class="pbody"><span class="eyebrow">{p.category}</span><h3>{p.title}</h3><span class="meta">{p.minutes} min read</span></div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style is:global>
  .post-head { margin-top: -80px; padding-block: clamp(130px, 12vw, 170px) 90px; background: linear-gradient(120deg, #0a2cb0 0%, #1654e6 45%, #2f84ff 100%); }
  .post-head .wrap { max-width: 920px; }
  .crumb { display: inline-block; margin-bottom: 26px; color: var(--muted); text-decoration: none; font-weight: 500; font-size: .94rem; }
  .crumb:hover { color: #fff; }
  .post-title { font-size: clamp(2.7rem, 6.4vw, 5.4rem); line-height: .98; letter-spacing: -.035em; margin: 14px 0 18px; }
  .post-meta { color: var(--muted); font-size: .94rem; }
  .post-cover { max-width: 1000px; margin: -60px auto 0; position: relative; aspect-ratio: 16 / 7; border-radius: 32px; overflow: hidden; border: 1px solid rgba(255,255,255,.25); box-shadow: 0 30px 60px rgba(2,8,40,.5); }
  .post-layout { display: grid; grid-template-columns: 230px minmax(0, 700px); gap: 60px; justify-content: center; padding-top: 60px; }
  .toc { position: sticky; top: 110px; align-self: start; font-size: .92rem; }
  .toc b { display: block; font-size: .72rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 6px 0 6px 16px; color: var(--muted); text-decoration: none; line-height: 1.35; }
  .toc a:hover { color: #fff; }
  .more-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 26px; }
  .post-layout .prose > :first-child { margin-top: 0; }
  .post-layout .prose > p:first-child { font-size: 1.28rem; line-height: 1.6; color: var(--text); }
  @media (max-width: 960px) { .post-layout { grid-template-columns: minmax(0, 1fr); gap: 0; } .toc { display: none; } .more-grid { grid-template-columns: 1fr; } .post-cover { border-radius: 24px; aspect-ratio: 16/9; } }
</style>
