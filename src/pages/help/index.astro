---
import Base from "../../layouts/Base.astro";
import { guides, helpGroups } from "../../content/help";
import { SITE } from "../../lib/site";

const jsonLd = [{
  "@context": "https://schema.org", "@type": "CollectionPage", name: "FreelanceDesk help center", url: SITE.url + "/help/",
  hasPart: guides.map((g) => ({ "@type": "Article", headline: g.title, url: `${SITE.url}/help/${g.slug}/` })),
}];
---
<Base title="Help center: how to use FreelanceDesk" description="Step-by-step guides for the FreelanceDesk app: invoices, quotations, clients, payments, backups, app lock and your subscription." jsonLd={jsonLd}>
  <section class="hc-hero">
    <div class="wrap">
      <p class="kicker">Help center</p>
      <h1>How can we <em>help?</em></h1>
      <label class="search"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input id="hq" type="search" placeholder="Search, e.g. backup, payment, quotation" autocomplete="off" /></label>
    </div>
  </section>

  <section class="section sec-light hc-body">
    <div class="wrap">
      {helpGroups.map((g) => (
        <div class="hc-group" data-group>
          <h2>{g}</h2>
          <div class="hc-grid">
            {guides.filter((x) => x.group === g).map((x) => (
              <a class="hc-card" href={`/help/${x.slug}/`} data-text={`${x.title} ${x.description}`.toLowerCase()}>
                <b>{x.title}</b><span>{x.description}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
      <p class="empty" id="hempty" hidden>No guides match that. Try another word, or <a href="/contact/">contact us</a>.</p>
      <div class="hc-more">
        <p>Can't find what you need?</p>
        <a class="btn btn-primary" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const q = document.getElementById("hq") as HTMLInputElement;
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".hc-card"));
  const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-group]"));
  const empty = document.getElementById("hempty") as HTMLElement;
  q.addEventListener("input", () => {
    const t = q.value.trim().toLowerCase();
    let shown = 0;
    cards.forEach((c) => { const ok = !t || (c.dataset.text || "").includes(t); c.hidden = !ok; if (ok) shown++; });
    groups.forEach((g) => { g.hidden = !g.querySelector(".hc-card:not([hidden])"); });
    empty.hidden = shown > 0;
  });
</script>

<style is:global>
  .hc-hero { margin-top: -80px; padding: clamp(130px, 12vw, 170px) 0 clamp(50px, 6vw, 80px); background: linear-gradient(120deg, #0a2cb0 0%, #1654e6 45%, #2f84ff 100%); }
  .hc-hero h1 { margin: 18px 0 30px; font-size: clamp(3rem, 8vw, 7rem); }
  .hc-hero .kicker { color: #d6e6ff; }
  .hc-hero .search { display: flex; align-items: center; gap: 12px; background: #fff; color: #5b6786; border-radius: 999px; padding: 0 22px; max-width: 620px; box-shadow: 0 14px 34px rgba(2,8,60,.3); }
  .hc-hero .search input { flex: 1; border: 0; outline: 0; background: none; font: inherit; font-size: 1.02rem; color: #0a1433; padding: 17px 0; min-width: 0; }
  .hc-body { padding-top: clamp(50px, 6vw, 80px); }
  .hc-group { margin-bottom: 54px; }
  .hc-group h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); letter-spacing: -.04em; margin-bottom: 20px; }
  .hc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .hc-card { display: grid; gap: 8px; align-content: start; padding: 24px; border-radius: 22px; background: #f1f5ff; border: 1px solid rgba(10,20,51,.08); text-decoration: none; color: #0a1433; transition: transform .2s ease, border-color .2s ease, background .2s ease; }
  .hc-card:hover { transform: translateY(-3px); border-color: rgba(29,91,224,.5); background: #e8efff; }
  .hc-card b { font-size: 1.2rem; font-weight: 600; letter-spacing: -.03em; line-height: 1.2; }
  .hc-card span { color: #4a5675; font-size: .95rem; line-height: 1.5; font-weight: 300; }
  .hc-more { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 28px 30px; border-radius: 24px; background: #0a1d6a; color: #fff; margin-top: 20px; }
  .hc-more p { font-size: 1.3rem; font-weight: 500; letter-spacing: -.03em; }
  .sec-light .empty { color: #4a5675; padding: 30px 0; }
  [hidden] { display: none !important; }
  @media (max-width: 900px) { .hc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .hc-grid { grid-template-columns: 1fr; } }
</style>
