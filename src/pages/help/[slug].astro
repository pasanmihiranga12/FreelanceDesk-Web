---
import Base from "../../layouts/Base.astro";
import { guides, type HelpGuide } from "../../content/help";
import { withToc } from "../../content/posts";
import { SITE } from "../../lib/site";

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
interface Props { guide: HelpGuide }
const { guide } = Astro.props;
const { body, toc } = withToc(guide.body);
const url = `${SITE.url}/help/${guide.slug}/`;
const related = guides.filter((g) => g.slug !== guide.slug && g.group === guide.group).concat(guides.filter((g) => g.group !== guide.group)).slice(0, 3);
const jsonLd = [
  { "@context": "https://schema.org", "@type": "TechArticle", headline: guide.title, description: guide.description, url, inLanguage: "en",
    author: { "@type": "Organization", name: SITE.company }, publisher: { "@type": "Organization", name: SITE.company } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "Help", item: SITE.url + "/help/" },
    { "@type": "ListItem", position: 3, name: guide.title, item: url } ] },
];
---
<Base title={guide.title} description={guide.description} type="article" jsonLd={jsonLd}>
  <header class="hg-head">
    <div class="wrap">
      <a class="crumb" href="/help/">← Help center</a>
      <p class="kicker">{guide.group}</p>
      <h1>{guide.title}</h1>
    </div>
  </header>
  <div class="wrap hg-layout">
    <aside class="toc" aria-label="On this page">
      <b>On this page</b>
      <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
    </aside>
    <div class="prose" style="margin:0">
      <div set:html={body} />
      <div class="callout">
        <p>Still stuck?</p>
        <p>Write to us and we'll help. Include your phone model and what you were trying to do.</p>
        <p style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px">
          <a class="btn btn-primary btn-sm" href="/contact/">Contact us</a>
          <a class="btn btn-ghost btn-sm" href={SITE.playUrl} rel="noopener">Get the app</a>
        </p>
      </div>
    </div>
  </div>
  <section class="wrap" style="padding-block:20px clamp(80px,10vw,130px)">
    <p class="kicker">More guides</p>
    <div class="hg-more">
      {related.map((g) => <a class="hc-card2" href={`/help/${g.slug}/`}><b>{g.title}</b><span>{g.description}</span></a>)}
    </div>
  </section>
</Base>

<style is:global>
  .hg-head { margin-top: -80px; padding: clamp(130px, 12vw, 170px) 0 60px; background: linear-gradient(120deg, #0a2cb0 0%, #1654e6 45%, #2f84ff 100%); }
  .hg-head .wrap { max-width: 920px; }
  .hg-head .kicker { color: #d6e6ff; }
  .hg-head h1 { margin-top: 14px; font-size: clamp(2.4rem, 5.6vw, 4.6rem); line-height: 1; max-width: 18ch; }
  .crumb { display: inline-block; margin-bottom: 22px; color: #d6e6ff; text-decoration: none; font-size: .94rem; }
  .crumb:hover { color: #fff; }
  .hg-layout { display: grid; grid-template-columns: 230px minmax(0, 700px); gap: 60px; justify-content: center; padding-top: 56px; }
  .toc { position: sticky; top: 110px; align-self: start; font-size: .92rem; }
  .toc b { display: block; font-size: .95rem; font-weight: 600; color: #fff; margin-bottom: 12px; }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 6px 0 6px 16px; color: var(--muted); text-decoration: none; line-height: 1.35; }
  .toc a:hover { color: #fff; }
  .hg-more { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 18px; }
  .hc-card2 { display: grid; gap: 8px; align-content: start; padding: 24px; border-radius: 22px; background: #08122e; border: 1px solid rgba(127,178,255,.28); text-decoration: none; color: #fff; transition: transform .2s ease, border-color .2s ease; }
  .hc-card2:hover { transform: translateY(-3px); border-color: rgba(127,178,255,.6); color: #fff; }
  .hc-card2 b { font-size: 1.15rem; font-weight: 600; letter-spacing: -.03em; line-height: 1.2; }
  .hc-card2 span { color: var(--muted); font-size: .92rem; line-height: 1.5; font-weight: 300; }
  @media (max-width: 960px) { .hg-layout { grid-template-columns: minmax(0, 1fr); gap: 0; } .toc { display: none; } .hg-more { grid-template-columns: 1fr; } }
</style>
