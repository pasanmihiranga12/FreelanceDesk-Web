---
import Base from "../layouts/Base.astro";
import Waitlist from "../components/Waitlist.astro";
import { SITE } from "../lib/site";

const faqs = [
  { q: "When will FreelanceDesk be on the App Store?", a: "We don't have a date yet. We're working on it, and everyone on this list will hear from us as soon as it is ready." },
  { q: "Can I use FreelanceDesk on my iPhone today?", a: "Not the app. The free invoice and quotation generators on this website work in any browser, including Safari on iPhone." },
  { q: "What will you do with my email?", a: "We'll email you when the App Store version is available. You can ask us to remove it at any time." },
];
const jsonLd = [{
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
}];
---
<Base title="FreelanceDesk for the App Store: join the waitlist" description="FreelanceDesk is on Android today. Join the waitlist to be told when the App Store version is ready." jsonLd={jsonLd}>
  <section class="as-hero">
    <div class="wrap as-grid">
      <div>
        <p class="kicker">Coming to the App Store</p>
        <h1>The App Store <em>is next.</em></h1>
        <p class="lead">FreelanceDesk is on Android today. Leave your email and we'll let you know as soon as the App Store version is ready.</p>
        <div style="margin-top:34px"><Waitlist /></div>
      </div>
      <div class="as-card" aria-hidden="true">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="#fff"><path d="M16.4 12.7c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.8-.8-3-.8-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.3 0 2.1-1.1 2.8-2.3.9-1.3 1.2-2.5 1.3-2.6-.1 0-2.5-1-2.5-3.8zM14.2 5.9c.6-.8 1.1-1.8.9-2.9-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.8-1 2.8 1 .1 2.1-.5 2.8-1.3z"/></svg>
        <b>Coming soon</b>
        <span>Join the waitlist</span>
      </div>
    </div>
  </section>

  <section class="section sec-light">
    <div class="wrap as-two">
      <div>
        <p class="kicker">Meanwhile</p>
        <h2 class="big" style="max-width:12ch">You don't have to <em>wait.</em></h2>
      </div>
      <div class="as-list">
        <a href="/free-invoice-generator/"><b>Free invoice generator</b><span>Works in Safari on your iPhone. Make a clean PDF in minutes.</span></a>
        <a href="/free-quotation-generator/"><b>Free quotation generator</b><span>A priced offer with terms, ready to send.</span></a>
        <a href={SITE.playUrl} rel="noopener"><b>Got an Android phone too?</b><span>The full app is on Google Play now.</span></a>
      </div>
    </div>
  </section>

  <section class="section sec-blue">
    <div class="wrap faq-wrap">
      <div><p class="kicker">Questions</p><h2 class="big">Quick <em>answers.</em></h2></div>
      <div>{faqs.map((f) => <details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>
</Base>

<style is:global>
  .as-hero { margin-top: -80px; padding: clamp(140px, 14vw, 190px) 0 clamp(70px, 8vw, 110px); background: linear-gradient(120deg, #0a2cb0 0%, #1654e6 45%, #2f84ff 100%); }
  .as-grid { display: grid; grid-template-columns: 1.3fr .7fr; gap: 50px; align-items: center; }
  .as-hero h1 { margin: 18px 0 22px; font-size: clamp(3rem, 8vw, 7rem); max-width: 10ch; }
  .as-hero .kicker { color: #d6e6ff; } .as-hero .lead { color: #e4eeff; }
  .as-card { display: grid; justify-items: center; gap: 8px; padding: 46px 30px; border-radius: 34px; background: #000; border: 1px solid rgba(255,255,255,.3); box-shadow: 0 40px 80px rgba(0,5,40,.5); transform: rotate(3deg); text-align: center; }
  .as-card b { font-size: 1.9rem; font-weight: 600; letter-spacing: -.04em; color: #fff; margin-top: 8px; }
  .as-card span { color: #aab6d8; }
  .as-two { display: grid; grid-template-columns: .9fr 1.1fr; gap: 50px; align-items: start; }
  .as-list { display: grid; }
  .as-list a { display: grid; gap: 4px; padding: 24px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--text); }
  .as-list a:first-child { border-top: 1px solid var(--line); }
  .as-list a b { font-size: 1.35rem; font-weight: 500; letter-spacing: -.03em; } .as-list a span { color: var(--soft); }
  .as-list a:hover b { color: #1d5be0; }
  .faq-wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: 60px; align-items: start; }
  .faq-wrap .big { max-width: 8ch; }
  .faq { border-bottom: 1px solid var(--line); } .faq:first-child { border-top: 1px solid var(--line); }
  .faq summary { cursor: pointer; font-size: clamp(1.15rem, 1.8vw, 1.4rem); font-weight: 500; letter-spacing: -.025em; padding: 24px 0; list-style: none; display: flex; justify-content: space-between; gap: 20px; line-height: 1.25; }
  .faq summary::-webkit-details-marker { display: none; } .faq summary::after { content: "+"; font-weight: 300; font-size: 1.8rem; line-height: 1; transition: transform .25s ease; }
  .faq[open] summary::after { transform: rotate(45deg); } .faq p { color: var(--soft); padding-bottom: 26px; max-width: 60ch; font-weight: 300; }
  @media (max-width: 860px) { .as-grid, .as-two, .faq-wrap { grid-template-columns: 1fr; } .as-card { transform: none; max-width: 320px; } }
</style>
