---
import Base from "../layouts/Base.astro";
---
<Base title="Choose a new password" description="Choose a new password for your FreelanceDesk account." noindex>
  <section class="section" style="padding-top:60px">
    <div class="wrap" style="max-width:460px">
      <div class="card" id="rp-card">
        <h2 style="font-size:1.6rem">Choose a new password</h2>
        <p id="rp-wait" style="margin-top:12px;color:var(--soft)">Checking your link…</p>

        <form id="rp-form" hidden style="display:grid;gap:14px;margin-top:18px">
          <label class="rp-label">New password <span style="font-weight:500;color:var(--muted)">at least 8 characters</span>
            <input name="password" type="password" minlength="8" required autocomplete="new-password" class="rp-input" />
          </label>
          <label class="rp-label">Repeat the password
            <input name="confirm" type="password" minlength="8" required autocomplete="new-password" class="rp-input" />
          </label>
          <button class="btn btn-blue" type="submit">Save new password</button>
        </form>

        <p id="rp-msg" role="status" aria-live="polite" style="margin-top:14px;min-height:1.3em"></p>
        <p style="margin-top:8px"><a href="/free-invoice-generator/">Go to the invoice generator →</a></p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { supabase, supabaseConfigured } from "../lib/supabase";

  const wait = document.getElementById("rp-wait") as HTMLElement;
  const form = document.getElementById("rp-form") as HTMLFormElement;
  const msg = document.getElementById("rp-msg") as HTMLElement;
  const say = (t: string, ok = false) => { msg.textContent = t; msg.style.color = ok ? "#5fe0b8" : "var(--red)"; };

  if (!supabaseConfigured || !supabase) {
    wait.textContent = "Accounts aren't connected on this site yet.";
  } else {
    let ready = false;
    const show = () => { ready = true; wait.hidden = true; form.hidden = false; form.style.display = "grid"; };
    supabase.auth.onAuthStateChange((event) => { if (event === "PASSWORD_RECOVERY") show(); });
    // If the link was already processed before this script ran, a session exists.
    setTimeout(async () => {
      if (ready) return;
      const { data } = await supabase!.auth.getSession();
      if (data.session) show(); else wait.textContent = "This link has expired or was already used. Request a new one from the Sign in box on a tool page.";
    }, 1500);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const pw = (form.elements.namedItem("password") as HTMLInputElement).value;
      const confirm = (form.elements.namedItem("confirm") as HTMLInputElement).value;
      if (pw.length < 8) return say("Use at least 8 characters.");
      if (pw !== confirm) return say("The two passwords don't match.");
      const { error } = await supabase!.auth.updateUser({ password: pw });
      if (error) return say("Couldn't save the password. Please request a new link and try again.");
      form.hidden = true;
      say("Your password has been changed. You're signed in.", true);
    });
  }
</script>

<style is:global>
  .rp-label { display: grid; gap: 7px; font-size: .88rem; font-weight: 700; color: var(--soft); }
  .rp-input { width: 100%; font: inherit; font-size: 1rem; color: var(--text); background: #07101f; border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
  .rp-input:focus { outline: none; border-color: var(--blue-light); box-shadow: 0 0 0 3px rgba(96,165,250,.2); }
</style>
