---
import ToolPage from "../components/ToolPage.astro";
---
<ToolPage
  kind="invoice"
  title="Free Invoice Generator: create a PDF invoice online"
  description="Make a clean, professional PDF invoice in your browser. Add your details, items, tax and payment info, then download it. Free for your first 2 invoices."
  h1="Free invoice generator"
  lead="Fill in your details, your client and your items, check the live preview, and download a clean PDF invoice. Nothing is uploaded: the PDF is made on your device."
  stepsTitle="How to create an invoice in four steps"
  steps={[
    { t: "Add your details.", d: "Your business or name, contact info and, if you have one, your tax or VAT number." },
    { t: "Add your client.", d: "Their name is enough. Add an email or address if you want them on the invoice." },
    { t: "List what you did.", d: "One line per job or item, with a quantity and a rate. The total adds up as you type." },
    { t: "Download the PDF.", d: "Check the preview on the right, then sign in and download. Send it to your client by email or message." },
  ]}
  includesTitle="What a good freelance invoice includes"
  includes={[
    "Your name or business name and contact details",
    "Your client's name",
    "A unique invoice number, so both of you can refer to it",
    "The invoice date and a clear due date",
    "A description of each item, with quantity and rate",
    "Subtotal, any discount, tax if it applies, and the total due",
    "How to pay you: bank details or a payment link",
    "A short note, such as late-payment terms or a thank you",
  ]}
  faqs={[
    { q: "Is the invoice generator really free?", a: "Yes. Create a free account and your first 2 invoices and 2 quotations are free. After that, the FreelanceDesk app has no limits." },
    { q: "Do I need an account?", a: "To download the PDF, yes. It lets us count your free documents. You can fill in the form and see the preview without signing in." },
    { q: "Is my information uploaded?", a: "No. The invoice is built in your browser. Your form is saved only in this browser so you don't retype it. We only store your email and how many free documents you've used." },
    { q: "Can I add tax or a discount?", a: "Yes. Enter a tax rate as a percentage and a discount as an amount. The tool works out the totals. Check the tax rules that apply to you, because this tool does not give tax advice." },
    { q: "Which currencies can I use?", a: "US dollars, euros, pounds, Sri Lankan rupees, Indian rupees, Australian, Canadian and Singapore dollars and UAE dirhams. The PDF supports Latin letters and numbers." },
  ]}
  related={[
    { href: "/free-quotation-generator/", label: "Free quotation generator" },
    { href: "/blog/what-to-include-on-a-freelance-invoice/", label: "What to include on a freelance invoice" },
    { href: "/blog/invoice-vs-quotation/", label: "Invoice vs quotation: what's the difference?" },
    { href: "/blog/how-to-chase-a-late-payment/", label: "How to chase a late payment politely" },
  ]}
/>
