---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";
const jsonLd = [{
  "@context": "https://schema.org", "@type": "ContactPage", name: "Contact FreelanceDesk", url: SITE.url + "/contact/",
  mainEntity: { "@type": "Organization", name: SITE.company, email: SITE.email, url: SITE.url },
}];
---
<Base title="Contact and support" description="Get help with FreelanceDesk. Email the team, read the help guides, or find answers about billing and your subscription." jsonLd={jsonLd}>
  <section class="ct-hero">
    <div class="wrap">
      <p class="kicker">Contact and support</p>
      <h1>We're here <em>to help.</em></h1>
      <p class="lead">Questions, problems or ideas? Write to us. A real person reads every message.</p>
      <p style="margin-top:30px"><a class="btn btn-white btn-xl" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
  </section>
  <section class="section sec-light">
    <div class="wrap ct-grid">
      <a class="ct-card" href="/help/"><b>Read the help guides</b><span>Step-by-step answers for invoices, quotations, payments, backups and more.</span></a>
      <a class="ct-card" href="/whats-new/"><b>See what's new</b><span>Release notes for every version of the app.</span></a>
      <a class="ct-card" href={SITE.playUrl} rel="noopener"><b>Billing and subscription</b><span>Payments, refunds and cancelling are handled by Google Play. Open the app's Play Store page to manage your subscription.</span></a>
    </div>
    <div class="wrap ct-tips">
      <h2>To help us help you faster</h2>
      <ul>
        <li>Tell us your phone model and Android version.</li>
        <li>Tell us the app version (it is shown in the app's settings).</li>
        <li>Describe what you did, what you expected and what happened.</li>
        <li>A screenshot helps. Please hide any client details first.</li>
      </ul>
      <p class="ct-small">Your data lives only on your phone, so we cannot see your clients or invoices. For that reason, please make a backup before trying anything drastic. {SITE.company} publishes FreelanceDesk.</p>
    </div>
  </section>
</Base>

<style is:global>
  .ct-hero { margin-top: -80px; padding: clamp(130px, 12vw, 170px) 0 clamp(60px, 7vw, 90px); background: linear-gradient(120deg, #0a2cb0 0%, #1654e6 45%, #2f84ff 100%); }
  .ct-hero h1 { margin: 18px 0 20px; font-size: clamp(3rem, 8vw, 7rem); max-width: 11ch; }
  .ct-hero .kicker { color: #d6e6ff; } .ct-hero .lead { color: #e4eeff; }
  .btn-white { background: #fff; color: #0a1433; box-shadow: 0 14px 34px rgba(0,10,60,.35); }
  .btn-white:hover { background: #fff; color: #0a1433; }
  .btn-xl { padding: 18px 36px; font-size: 1.1rem; }
  .ct-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .ct-card { display: grid; gap: 10px; align-content: start; padding: 30px; border-radius: 26px; background: #f1f5ff; border: 1px solid rgba(10,20,51,.08); text-decoration: none; color: #0a1433; transition: transform .2s ease, border-color .2s ease; }
  .ct-card:hover { transform: translateY(-4px); border-color: rgba(29,91,224,.5); }
  .ct-card b { font-size: 1.4rem; font-weight: 600; letter-spacing: -.035em; line-height: 1.15; }
  .ct-card span { color: #4a5675; line-height: 1.55; font-weight: 300; }
  .ct-tips { margin-top: 56px; max-width: 760px; }
  .ct-tips h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); letter-spacing: -.04em; margin-bottom: 16px; }
  .ct-tips ul { padding-left: 1.2em; display: grid; gap: 8px; color: #3f4c6e; }
  .ct-tips li::marker { color: #1d5be0; }
  .ct-small { margin-top: 20px; color: #5b6786; font-size: .95rem; line-height: 1.6; }
  @media (max-width: 860px) { .ct-grid { grid-template-columns: 1fr; } }
</style>
