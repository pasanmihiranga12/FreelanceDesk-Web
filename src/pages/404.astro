---
import Base from "../layouts/Base.astro";
import { posts } from "../content/posts";
const picks = [...posts].slice(0, 3);
---
<Base title="Page not found" description="That page doesn't exist. Try the free invoice generator, the quotation generator or the blog." noindex={true}>
  <section class="nf">
    <div class="wrap">
      <p class="kicker">Error 404</p>
      <h1>This page <em>doesn't exist.</em></h1>
      <p class="lead">The link may be old or mistyped. Here is where most people want to go.</p>
      <div class="nf-actions">
        <a class="btn btn-white btn-xl" href="/">Back to the home page</a>
        <a class="btn btn-ghost" href="/free-invoice-generator/">Free invoice generator</a>
        <a class="btn btn-ghost" href="/free-quotation-generator/">Free quotation generator</a>
      </div>
      <div class="nf-posts">
        <p class="kicker">Or read something useful</p>
        <ul>{picks.map((p) => <li><a href={`/blog/${p.slug}/`}>{p.title}</a></li>)}<li><a href="/blog/">All posts →</a></li></ul>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .nf { margin-top: -80px; min-height: 100svh; display: flex; align-items: center; padding: 140px 0 80px; background: linear-gradient(120deg, #0a2cb0 0%, #1654e6 45%, #2f84ff 100%); }
  .nf h1 { margin: 18px 0 22px; font-size: clamp(3rem, 9vw, 7.5rem); max-width: 12ch; }
  .nf .kicker { color: #d6e6ff; }
  .nf .lead { color: #e4eeff; }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 34px; }
  .nf-posts { margin-top: 56px; }
  .nf-posts ul { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 4px; }
  .nf-posts a { color: #fff; font-size: 1.1rem; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,.35); }
  .nf-posts a:hover { border-color: #fff; }
  .btn-white { background: #fff; color: #0a1433; box-shadow: 0 14px 34px rgba(0,10,60,.35); }
  .btn-white:hover { background: #fff; color: #0a1433; }
  .btn-xl { padding: 20px 40px; font-size: 1.1rem; }
</style>
