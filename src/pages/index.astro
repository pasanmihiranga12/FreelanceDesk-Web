---
import Base from "../layouts/Base.astro";
import Cover from "../components/Cover.astro";
import Waitlist from "../components/Waitlist.astro";
import { SITE } from "../lib/site";
import { posts } from "../content/posts";

const faqs = [
  { q: "Is FreelanceDesk free?", a: "Yes, it is free to download and use. The free plan has unlimited clients, up to 5 orders, the Classic and Minimal invoice templates, payments, reminders and backups. Premium unlocks unlimited orders, all 20 invoice templates, quotations, e-signatures, income analytics and recaps. It costs $1.99 a month or $14.99 a year, starts with a free trial, is billed by Google Play and can be cancelled any time. The invoice and quotation generators on this website are separate and free: 2 invoices and 2 quotations every month." },
  { q: "Where is my data stored?", a: "On your phone only. FreelanceDesk has no account system and no cloud. Your clients, invoices and payments never leave your device unless you export or share them yourself." },
  { q: "Does it work offline?", a: "Yes. Everything in the app works without an internet connection. It only needs a connection to confirm your subscription with Google Play now and then." },
  { q: "Can I send professional PDF invoices and quotations?", a: "Yes. Create an invoice or quotation, pick a template, add your logo and signature if you like, and share the PDF straight from your phone. A quotation turns into an invoice in one tap." },
  { q: "Which currencies does it support?", a: "You can work in your own currency and create orders in other currencies. The app converts them for your totals and keeps the original amount on the invoice." },
  { q: "Is there an iPhone version?", a: "Not yet. FreelanceDesk is on Android today." },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "FreelanceDesk",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Android",
    description: "Invoices, quotations, clients and payments for freelancers. Private, offline and ad-free.",
    url: SITE.url,
    offers: [
      { "@type": "Offer", name: "Free", price: "0", priceCurrency: "USD" },
      { "@type": "Offer", name: "Premium monthly", price: "1.99", priceCurrency: "USD" },
      { "@type": "Offer", name: "Premium yearly", price: "14.99", priceCurrency: "USD" },
    ],
    publisher: { "@type": "Organization", name: SITE.company, url: SITE.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];

const rows = [
  { n: "01", t: "Invoices & quotations", d: "Clean PDFs from an order or from scratch. An accepted quote becomes an invoice in one tap, with every number carried over." },
  { n: "02", t: "Templates & your brand", d: "Pick a template, add your logo and see a live preview before you send." },
  { n: "03", t: "E-signatures", d: "Draw your signature once, keep a signature library and attach one to any invoice." },
  { n: "04", t: "Clients", d: "A profile for every client with photo, category, notes, contact details and their full history." },
  { n: "05", t: "Orders & recurring work", d: "Fixed-fee or campaign orders with due dates. Repeat orders create themselves on your schedule." },
  { n: "06", t: "Payments & reminders", d: "Record full or part payments, see what is still outstanding and get reminders on your phone." },
  { n: "07", t: "Income analytics", d: "A swipeable income chart, monthly breakdowns, best months and client stats on your dashboard." },
  { n: "08", t: "Recaps & badges", d: "A shareable monthly and yearly recap, badges as you grow, and a score for every client." },
  { n: "09", t: "Tax set-aside & export", d: "See roughly how much of your income to keep aside for tax, and export your finances to CSV." },
  { n: "10", t: "Private by design", d: "No account, no cloud, no ads. Works offline, with an optional PIN or fingerprint lock and full backup and restore." },
];
const tpls = [
  { id: "eclipse", n: "Eclipse", d: "Navy night, golden sun" },
  { id: "holo", n: "Holo", d: "Pastel mesh, rainbow table" },
  { id: "pop", n: "Pop", d: "Loud blocks, hard shadows" },
  { id: "aurora", n: "Aurora", d: "Black with a glowing ridge" },
  { id: "orbit", n: "Orbit", d: "Violet gradient hero" },
  { id: "mosaic", n: "Mosaic", d: "Geometric violet and yellow" },
  { id: "silk", n: "Silk", d: "White card on silver waves" },
  { id: "neon", n: "Neon", d: "Black grid, neon glow" },
  { id: "blossom", n: "Blossom", d: "Soft grey, mauve pills" },
  { id: "midnight", n: "Midnight", d: "Black with violet pills" },
];
const latest = [...posts].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
---
<Base
  title="FreelanceDesk: invoices, quotations and clients for freelancers"
  description="A private, offline app for freelancers to create invoices and quotations, track clients and payments, and see their income. Free invoice and quotation generator online."
  jsonLd={jsonLd}
>
    <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="hero-tag">For freelancers who'd rather be working</p>
      <h1>
        Invoices that look like you<br />
        <em>mean business.</em>
      </h1>
      <div class="hero-foot">
        <p class="lead">Create a professional invoice or quotation in minutes, free, right here in your browser. Then run your whole freelance business from the app.</p>
        <div class="hero-cta">
          <a class="btn btn-white btn-xl" href="/free-invoice-generator/">Create an invoice</a>
          <div class="hero-cta-2">
            <a class="as-badge" href="/app-store/" aria-label="Join the App Store waitlist"><svg width="24" height="26" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M16.4 12.7c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.8-.8-3-.8-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.3 0 2.1-1.1 2.8-2.3.9-1.3 1.2-2.5 1.3-2.6-.1 0-2.5-1-2.5-3.8zM14.2 5.9c.6-.8 1.1-1.8.9-2.9-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.8-1 2.8 1 .1 2.1-.5 2.8-1.3z"/></svg><span><small>COMING SOON TO THE</small><b>App Store</b></span></a>
            <a class="gp" href={SITE.playUrl} rel="noopener"><img src="/google-play-badge.svg" alt="Get it on Google Play" width="217" height="63" /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FREE TOOLS -->
  <section class="section sec-light">
    <div class="wrap">
      <p class="kicker">Free, in your browser</p>
      <h2 class="big">Need a document <em>right now?</em></h2>
      <p class="lead" style="margin-top:26px">Make a free account and create {SITE.freeLimit} invoices and {SITE.freeLimit} quotations here, free every month. Want more? Get the app: it is free to start, and Premium removes the limits.</p>
      <div class="tools">
        <a class="tool" href="/free-invoice-generator/">
          <h3>Invoice generator</h3>
          <p>Your details, your client, your items. A clean PDF with the total front and centre.</p>
          <span class="go">Create an invoice →</span>
        </a>
        <a class="tool" href="/free-quotation-generator/">
          <h3>Quotation generator</h3>
          <p>A priced offer with a valid-until date and clear terms, ready to win the job.</p>
          <span class="go">Create a quotation →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- TEMPLATES -->
  <section class="section sec-night tpl-sec">
    <div class="wrap">
      <p class="kicker">Only in the app</p>
      <h2 class="big wide">Invoices people <em>remember.</em></h2>
      <p class="lead" style="margin-top:24px">The free generator gives you five clean templates. The app has 20 invoice templates and 6 quotation templates, from sharp and professional to bold and unforgettable. Here is a peek.</p>
    </div>
    <div class="tpl-scroll">
      <button type="button" class="tpl-arrow prev" id="tpl-prev" aria-label="Previous templates"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button type="button" class="tpl-arrow next" id="tpl-next" aria-label="More templates"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>
      <div class="tpl-track" id="tpl-track">
        {tpls.map((t) => (
          <a class="tpl" href={SITE.playUrl} rel="noopener" aria-label={`${t.n} template, available in the app`}>
            <div class="tpl-img">
              <img src={`/templates/${t.id}.webp`} alt={`${t.n} invoice template preview`} width="640" height="905" loading="lazy" />
              <span class="lock"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>In the app</span>
            </div>
            <div class="tpl-meta"><b>{t.n}</b><small>{t.d}</small></div>
          </a>
        ))}
      </div>
    </div>
    <div class="wrap tpl-cta">
      <p>Unlock all of them with Premium in the app.</p>
      <a class="gp" href={SITE.playUrl} rel="noopener"><img src="/google-play-badge.svg" alt="Get it on Google Play" width="217" height="63" /></a>
    </div>
  </section>

  <!-- THE APP -->
  <section class="section sec-blue app-sec">
    <div class="wrap app-grid">
      <div class="app-copy">
        <p class="kicker">The app</p>
        <h2 class="big">Your whole freelance business, <em>in your pocket.</em></h2>
        <p class="lead" style="margin-top:26px">Invoices and quotations are just the start. FreelanceDesk keeps your clients, deadlines, payments and income together, privately on your phone, with no account and no cloud.</p>
        <div class="cta-row" style="margin-top:34px">
          <a class="gp" href={SITE.playUrl} rel="noopener"><img src="/google-play-badge.svg" alt="Get it on Google Play" width="217" height="63" /></a>
          <span class="price-note"><b>Free to download</b> · Premium from $1.99 a month</span>
        </div>
      </div>

      <div class="phone-stage"><img class="phone-img" src="/phone.webp" alt="The FreelanceDesk app dashboard on a phone" width="1687" height="1576" loading="lazy" /></div>
    </div>

    <div class="wrap">
      <ol class="rows">
        {rows.map((r) => (
          <li><span class="r-n">{r.n}</span><h3>{r.t}</h3><p>{r.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PRIVACY -->
  <section class="section sec-light">
    <div class="wrap">
      <p class="kicker">Privacy first</p>
      <h2 class="big wide">Your clients and your money <em>stay on your phone.</em></h2>
      <div class="priv">
        <p class="lead">FreelanceDesk has no sign-up and no servers holding your business data. There are no ads and no trackers in the app.</p>
        <ul class="checks">
          <li>No account to create</li>
          <li>Everything works offline</li>
          <li>No advertising or analytics in the app</li>
          <li>Optional PIN or fingerprint lock</li>
          <li>Export or erase your data any time</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section sec-blue price-sec">
    <div class="wrap price-grid">
      <div>
        <p class="kicker">Simple pricing</p>
        <h2 class="big">Free to start. <em>Premium when you grow.</em></h2>
        <p class="lead" style="margin-top:24px">Download FreelanceDesk free and run your first 5 orders on us. Upgrade when you need more. Premium starts with a free trial, is billed by Google Play and can be cancelled any time. Prices may vary by country.</p>
      </div>
      <div class="plans">
        <div class="price-card">
          <p class="plan-name">Free</p>
          <div class="price"><span class="num">$0</span></div>
          <ul>
            <li>Unlimited clients</li>
            <li>Up to 5 orders</li>
            <li>Classic &amp; Minimal templates</li>
            <li>Payments, reminders &amp; tax</li>
            <li>Backup, CSV export &amp; PIN lock</li>
          </ul>
          <span class="plan-foot">Free to download</span>
        </div>
        <div class="price-card plan-pro">
          <p class="plan-name">Premium <span class="plan-tag">Save 37% yearly</span></p>
          <div class="price"><span class="num">$1.99</span><small>/ month</small></div>
          <p class="plan-alt">or <b>$14.99</b> a year</p>
          <ul>
            <li>Unlimited orders</li>
            <li>All 20 invoice templates</li>
            <li>Quotations &amp; e-signatures</li>
            <li>Income analytics &amp; recaps</li>
            <li>Fingerprint or face unlock</li>
          </ul>
          <a class="gp" href={SITE.playUrl} rel="noopener"><img src="/google-play-badge.svg" alt="Get it on Google Play" width="217" height="63" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section sec-light">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="kicker">The blog</p><h2 class="big">Learn to get <em>paid properly.</em></h2></div>
        <a class="btn btn-ghost" href="/blog/">All posts →</a>
      </div>
      <div class="guides">
        {latest.map((p) => (
          <a class="pcard" href={`/blog/${p.slug}/`}>
            <div class="pimg"><Cover slug={p.slug} /></div>
            <div class="pbody"><span class="kicker">{p.category}</span><h3>{p.title}</h3><span class="meta">{p.minutes} min read</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- APP STORE -->
  <section class="section sec-night as-sec">
    <div class="wrap as-home">
      <div>
        <p class="kicker">Coming next</p>
        <h2 class="big wide">The App Store <em>is next.</em></h2>
        <p class="lead" style="margin-top:24px">FreelanceDesk is on Android today. Leave your email and we'll let you know as soon as the App Store version is ready.</p>
        <div style="margin-top:30px"><Waitlist dark /></div>
      </div>
      <a class="as-card" href="/app-store/" aria-label="About the App Store version">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M16.4 12.7c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.8-.8-3-.8-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.3 0 2.1-1.1 2.8-2.3.9-1.3 1.2-2.5 1.3-2.6-.1 0-2.5-1-2.5-3.8zM14.2 5.9c.6-.8 1.1-1.8.9-2.9-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.8-1 2.8 1 .1 2.1-.5 2.8-1.3z"/></svg>
        <b>Coming soon</b>
        <span>Join the waitlist →</span>
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section sec-blue">
    <div class="wrap faq-wrap">
      <div><p class="kicker">Questions</p><h2 class="big">Good <em>questions.</em></h2></div>
      <div>
        {faqs.map((f) => (
          <details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final sec-light">
    <div class="wrap">
      <h2>Get paid faster. <em>Look the part.</em></h2>
      <div class="cta-row" style="justify-content:center;margin-top:40px">
        <a class="btn btn-primary btn-xl" href="/free-invoice-generator/">Create a free invoice</a>
        <a class="gp" href={SITE.playUrl} rel="noopener"><img src="/google-play-badge.svg" alt="Get it on Google Play" width="217" height="63" /></a>
      </div>
    </div>
  </section>
</Base>

<script>
  const track = document.getElementById("tpl-track") as HTMLElement;
  const prev = document.getElementById("tpl-prev") as HTMLButtonElement;
  const next = document.getElementById("tpl-next") as HTMLButtonElement;
  const step = () => Math.max(280, Math.round(track.clientWidth * 0.8));
  const sync = () => {
    prev.disabled = track.scrollLeft < 8;
    next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
  };
  prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
  next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
  track.addEventListener("scroll", sync, { passive: true });
  window.addEventListener("resize", sync);
  sync();

  // drag with the mouse (touch already scrolls natively)
  let down = false, startX = 0, startLeft = 0, moved = false;
  track.addEventListener("pointerdown", (e) => {
    if (e.pointerType !== "mouse") return;
    down = true; moved = false; startX = e.clientX; startLeft = track.scrollLeft;
  });
  window.addEventListener("pointermove", (e) => {
    if (!down) return;
    const dx = e.clientX - startX;
    if (Math.abs(dx) > 4) { moved = true; track.style.scrollSnapType = "none"; track.classList.add("drag"); }
    track.scrollLeft = startLeft - dx;
  });
  window.addEventListener("pointerup", () => {
    if (!down) return;
    down = false; track.classList.remove("drag"); track.style.scrollSnapType = "";
  });
  track.addEventListener("click", (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);
</script>

<style is:global>
  /* ── HERO SIZE: edit these two numbers to fit a new image ───────────────────────────
     --hero-mobile-height : how tall the hero is on a phone, as a multiple of the screen width.
                            vw means "percent of screen width", so 285vw = 2.85 x the width.
                            Full image = (image height / image width) x 100, e.g. 940 x 2856 -> 304vw.
                            Lower number = shorter section (trims the empty top of the image).
     --hero-mobile-top    : space above the text on a phone (below the logo bar).
     --hero-tablet-height : hero height on a tablet held upright, also as a multiple of the screen width
                            (140vw = 1.4 x the width, an image about 5:7). Text and buttons on tablets are
                            sized in vw too, so every iPad looks the same, just bigger or smaller.
     --hero-tablet-top    : space above the text on a tablet (17vw = 17% of the screen width). */
  :root { --hero-mobile-height: 265vw; --hero-mobile-top: 130px; --hero-tablet-height: 140vw; --hero-tablet-top: 17vw; }

  /* hero: the supplied photo (phone on the right), so the copy sits on the left over a soft shade */
  .hero { position: relative; overflow: hidden; margin-top: -80px; min-height: 100svh; display: flex; align-items: center; padding: 104px 0 56px; background: #03050f url("/hero-bg.webp") right center / cover no-repeat; }
  .hero::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 90px; background: linear-gradient(180deg, transparent, rgba(3,5,15,.55)); pointer-events: none; }
  .hero-inner { position: relative; z-index: 2; text-align: left; display: flex; flex-direction: column; align-items: flex-start; }
  .hero-inner > * { max-width: min(54%, 760px); }
  .hero-tag { font-size: 1rem; font-weight: 500; color: #e3edff; text-shadow: 0 1px 16px rgba(2,6,32,.55); }
  .hero .lead { color: #fff; text-shadow: 0 1px 18px rgba(2,6,32,.6); }
  .hero h1 { margin: 16px 0 0; font-size: clamp(2.8rem, min(6vw, 11.5vh), 7.4rem); line-height: 1; letter-spacing: -.055em; font-weight: 500; } .hero h1 em { display: block; margin-top: .06em; font-size: .78em; letter-spacing: -.025em; }
  @media (min-width: 900px) and (orientation: landscape) {
    .hero-inner { max-width: none; padding-inline: clamp(24px, 5.5vw, 110px); }
    .hero-inner > * { max-width: min(56%, 820px); }
  }
  @media (min-width: 1380px) and (orientation: landscape) {
    .hero h1 { max-width: none; white-space: nowrap; font-size: clamp(3.4rem, min(5vw, 11vh), 7.4rem); }
  }
  .hero-foot { margin-top: clamp(20px, 3.4vh, 36px); display: grid; justify-items: start; gap: clamp(18px, 2.8vh, 28px); max-width: 600px; } .hero .lead { font-size: clamp(1rem, 1.25vw, 1.15rem); margin-inline: 0; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  .store { display: inline-flex; align-items: center; gap: 12px; padding: 9px 24px 9px 18px; border-radius: 999px; background: #000; border: 1px solid rgba(255,255,255,.3); color: #fff; text-decoration: none; transition: transform .18s ease, border-color .18s ease; }
  .store:hover { transform: translateY(-2px); border-color: rgba(255,255,255,.65); color: #fff; }
  .store span { display: grid; line-height: 1.1; } .store small { font-size: .62rem; letter-spacing: .1em; color: rgba(255,255,255,.75); font-weight: 500; } .store b { font-size: 1.2rem; font-weight: 600; letter-spacing: -.01em; }


  /* templates teaser */
  .sec-night { background: linear-gradient(180deg, rgba(10,36,144,0) calc(100% - 160px), #0a2490 100%), radial-gradient(75% 90% at 82% -10%, rgba(47,132,255,.9) 0%, rgba(47,132,255,0) 62%), radial-gradient(60% 80% at 8% 112%, rgba(26,84,230,.78) 0%, rgba(26,84,230,0) 65%), linear-gradient(112deg, rgba(3,8,34,0) 24%, rgba(37,120,255,.45) 48%, rgba(3,8,34,0) 72%), linear-gradient(180deg, #030820 0%, #061548 50%, #0b2490 100%); color: #fff; }
  .tpl-scroll { margin-top: 50px; }
  .tpl-scroll { position: relative; }
  .tpl-track.drag { cursor: grabbing; user-select: none; }
  .tpl-arrow { position: absolute; z-index: 5; top: 38%; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: #0a1433; border: 0; cursor: pointer; box-shadow: 0 12px 30px rgba(0,0,0,.45); transition: transform .15s ease, opacity .15s ease; }
  .tpl-arrow:hover { transform: scale(1.07); }
  .tpl-arrow:disabled { opacity: 0; pointer-events: none; }
  .tpl-arrow.prev { left: max(10px, calc((100vw - 1180px) / 2 - 24px)); }
  .tpl-arrow.next { right: max(10px, calc((100vw - 1180px) / 2 - 24px)); }
  @media (max-width: 700px) { .tpl-arrow { display: none; } }

  .tpl-track { display: flex; gap: 22px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 12px max(22px, calc((100vw - 1180px) / 2 + 22px)) 34px; scrollbar-width: none; }
  .tpl-track::-webkit-scrollbar { display: none; }
  .tpl { flex: none; width: min(270px, 66vw); scroll-snap-align: start; text-decoration: none; color: #fff; display: grid; gap: 14px; }
  .tpl-img { position: relative; border-radius: 16px; overflow: hidden; box-shadow: 0 26px 50px rgba(0,0,0,.45); transition: transform .25s ease; background: #111; aspect-ratio: 640 / 905; }
  .tpl:hover .tpl-img { transform: translateY(-6px); }
  .tpl-img img { display: block; width: 100%; height: 100%; object-fit: cover; }
